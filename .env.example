# Copy to .env.local for local dev. On Vercel, add these in Project -> Settings -> Environment Variables.

# Google OAuth (see README step 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The ONLY Google account allowed to sign in (your personal Gmail)
ALLOWED_EMAIL=

# NextAuth
NEXTAUTH_SECRET=            # run: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000   # on Vercel: https://<your-app>.vercel.app

# Protects the daily cron endpoint (any long random string)
CRON_SECRET=

# Upstash Redis (added automatically by the Vercel Marketplace integration;
# either naming scheme works)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
